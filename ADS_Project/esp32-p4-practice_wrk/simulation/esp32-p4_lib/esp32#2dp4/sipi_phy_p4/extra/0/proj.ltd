  MASK 1008 Name=GND2 PRECEDENCE=0 COLOR="f6768e" MATERIAL=Copper OPERATION=OperationThickness_GND2
  MASK 1009 Name=Bottom_Layer PRECEDENCE=0 COLOR="00538a" MATERIAL=Copper OPERATION=OperationThickness_Bottom_Layer
