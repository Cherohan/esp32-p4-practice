END_UNITS

BEGIN_MATERIAL
  MATERIAL Copper CONDUCTIVITY=5.900e+07 IMAG_CONDUCTIVITY=0 PERMEABILITY=1
  MATERIAL FR_4 PERMITTIVITY=4.6 LOSSTANGENT=0.01 PERMEABILITY=1 IMAG_PERMEABILITY=0 DJORDJEVIC LOWFREQ=1000 VALUEFREQ=1000000000 HIGHFREQ=1000000000000
  MATERIAL PP_006 PERMITTIVITY=4.6 LOSSTANGENT=0.01 PERMEABILITY=1 IMAG_PERMEABILITY=0 DJORDJEVIC LOWFREQ=1000 VALUEFREQ=1000000000 HIGHFREQ=1000000000000
