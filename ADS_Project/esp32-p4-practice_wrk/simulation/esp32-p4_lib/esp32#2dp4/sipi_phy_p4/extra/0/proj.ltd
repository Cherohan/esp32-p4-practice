  MASK 1026 Name=Drill_Guide__Top_Layer___Bottom_Layer__Plated PRECEDENCE=0 COLOR="817066" MATERIAL=PERFECT_CONDUCTOR OPERATION=OperationDRILL MASK_PROPERTIES = { "TopTechnologyMaskName=Drill_Guide__Top_Layer_-_Bottom_Layer__Plated", "OriginalName=Drill_Guide__Top_Layer_-_Bottom_Layer__Plated" }
  MASK 1027 Name=Drill_Guide__Top_Layer___Bottom_Layer__diel PRECEDENCE=0 COLOR="007d34" MATERIAL=AIR OPERATION=OperationDRILL MASK_PROPERTIES = { "TopTechnologyMaskName=Drill_Guide__Top_Layer_-_Bottom_Layer__diel", "OriginalName=Drill_Guide__Top_Layer_-_Bottom_Layer__diel" }
END_MASK

